# Copy this file to .env and fill only the providers you use.
TERA_MIMO_API_BASE=https://token-plan-cn.xiaomimimo.com/v1
TERA_MIMO_API_KEY=
TERA_MIMO_MODEL=mimo-v2.5-pro

# Recommended default. DeepSeek uses its Anthropic-compatible endpoint.
TERA_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
TERA_DEEPSEEK_API_KEY=
TERA_DEEPSEEK_MODEL=deepseek-v4-pro

# Optional right.codes shared key. Used by --provider openai and --provider anthropic when provider-specific keys are empty.
TERA_RIGHT_CODES_API_KEY=

# Default OpenAI-compatible endpoint. Change this if you use another /responses-compatible service.
TERA_OPENAI_API_BASE=https://www.right.codes/codex/v1
TERA_OPENAI_API_KEY=
TERA_OPENAI_MODEL=gpt-5.4

# Default Anthropic-compatible endpoint. Can reuse TERA_RIGHT_CODES_API_KEY when your gateway shares one key.
TERA_ANTHROPIC_API_BASE=https://www.right.codes/claude/v1
TERA_ANTHROPIC_API_KEY=
TERA_ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional comma-separated extra env names to redact from traces and reports.
TERA_SECRET_ENV_NAMES=
